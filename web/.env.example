# Vite build-time WMTS configuration. Copy to .env.local and fill a permitted key.
# EPSG:3857 / matrixSet w only; never apply GCJ-02 offsets to WGS84 positions.
# Leave URLs blank to avoid all third-party basemap requests.
VITE_WMTS_ROAD_URL=
VITE_WMTS_LABEL_URL=
VITE_WMTS_KEY=
VITE_WMTS_ROAD_LAYER=vec
VITE_WMTS_LABEL_LAYER=cva
VITE_WMTS_MATRIX_SET=w
VITE_WMTS_STYLE=default
VITE_WMTS_FORMAT=tiles
VITE_WMTS_ATTRIBUTION=天地图 · 国家地理信息公共服务平台
# Tianditu URL templates (not exercised by ticket07 browser tests):
# VITE_WMTS_ROAD_URL=https://t0.tianditu.gov.cn/vec_w/wmts?tk={key}
# VITE_WMTS_LABEL_URL=https://t0.tianditu.gov.cn/cva_w/wmts?tk={key}
