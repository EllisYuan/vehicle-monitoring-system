# 复制为本地环境变量文件或在启动 shell 中导出；不要提交真实凭证。
# 首次在空库启动时必须提供初始管理员；之后可移除，已有账号不会被改写。
VMS_BOOTSTRAP_ADMIN_USERNAME=replace-with-admin-username
VMS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-password

# 数据库与缓存（默认值指向开发用本地实例）
VMS_DB_URL=jdbc:mysql://127.0.0.1:3306/vms?connectionTimeZone=Asia/Shanghai&forceConnectionTimeZoneToSession=true&allowPublicKeyRetrieval=true&useSSL=false
VMS_DB_USERNAME=replace-with-db-user
VMS_DB_PASSWORD=replace-with-db-password
VMS_REDIS_HOST=127.0.0.1
VMS_REDIS_PORT=6379

# 服务端口
VMS_SERVER_PORT=8080
